{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homeapp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "observability": { "enabled": true },

  // The React app is served as static assets. Anything under /api/* goes to the
  // Worker first; every other unknown path falls back to index.html (SPA routing).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homeapp",
      "database_id": "c6880ddb-ba90-4eb8-8941-4820dd8d96a1",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Access settings. Both are public identifiers, not secrets.
  // Left empty, the API refuses every request outside local dev (fails closed).
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ancient-breeze-dbcb.cloudflareaccess.com",
    "ACCESS_AUD": "be9053a008a3f25c50668caf512f7848d6d359178ad27b05873396d39fce2818"
  }
  // Who may sign in is decided entirely by the Access policy in Cloudflare.
  // (The optional ALLOWED_EMAILS secret is deliberately not set.)
}
